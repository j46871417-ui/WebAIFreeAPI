#!/usr/bin/env bash
# WebAIFreeAPI - Linux Launcher & Service Manager
# Compatible with: ROSA Linux 13, RHEL/Fedora, Debian/Ubuntu, Arch, openSUSE and Freedesktop standards.

set -e

# ==============================================================================
# Helper functions & Localization
# ==============================================================================
is_ru() {
  case "${LANG:-}" in
    ru*|RU*|be*|uk*) return 0 ;;
    *) return 1 ;;
  esac
}

msg() {
  local ru="$1"
  local en="$2"
  if is_ru; then
    printf "%b\n" "$ru"
  else
    printf "%b\n" "$en"
  fi
}

# ==============================================================================
# Environment & Node.js validation
# ==============================================================================
NODE_BIN="${NODE_BIN:-node}"

if ! command -v "$NODE_BIN" >/dev/null 2>&1; then
  if [ -x "/usr/bin/node" ]; then
    NODE_BIN="/usr/bin/node"
  elif [ -x "/usr/local/bin/node" ]; then
    NODE_BIN="/usr/local/bin/node"
  else
    msg "❌ Ошибка: Node.js не найден в системе. Установите Node.js >= 18 (например: sudo dnf install nodejs или sudo apt install nodejs)." \
        "❌ Error: Node.js not found in PATH. Please install Node.js >= 18 (e.g., sudo dnf install nodejs or sudo apt install nodejs)." >&2
    exit 1
  fi
fi

NODE_VER_RAW="$("$NODE_BIN" -v 2>/dev/null || echo "")"
NODE_MAJOR=$(echo "$NODE_VER_RAW" | sed -E 's/^v?([0-9]+).*/\1/')

if [ -z "$NODE_MAJOR" ] || [ "$NODE_MAJOR" -lt 18 ] 2>/dev/null; then
  msg "❌ Ошибка: Обнаружен Node.js $NODE_VER_RAW. Для WebAIFreeAPI требуется Node.js версии >= 18." \
      "❌ Error: Detected Node.js $NODE_VER_RAW. WebAIFreeAPI requires Node.js version >= 18." >&2
  exit 1
fi

# ==============================================================================
# Resolve Base Directory
# ==============================================================================
resolve_canonical_path() {
  local target="$1"
  if command -v realpath >/dev/null 2>&1; then
    realpath "$target" 2>/dev/null && return 0
  fi
  if command -v readlink >/dev/null 2>&1; then
    readlink -f "$target" 2>/dev/null && return 0
  fi
  echo "$target"
}

resolve_base_dir() {
  # 1. User override via environment variable
  if [ -n "${AI_FREE_HOME:-}" ] && [ -f "${AI_FREE_HOME}/bin/deepseek.mjs" ]; then
    echo "$AI_FREE_HOME"
    return 0
  fi

  # 2. Standard system package location
  if [ -f "/opt/ai-free/bin/deepseek.mjs" ]; then
    echo "/opt/ai-free"
    return 0
  fi

  # 3. Path relative to this script
  local script_path
  script_path="$(resolve_canonical_path "$0")"
  local script_dir
  script_dir="$(cd "$(dirname "$script_path")" >/dev/null 2>&1 && pwd)"

  # Repository layout: <root>/linux/bin/ai-free
  if [ -f "$script_dir/../../bin/deepseek.mjs" ]; then
    cd "$script_dir/../.." >/dev/null 2>&1 && pwd
    return 0
  fi

  # Package layout: <root>/bin/ai-free
  if [ -f "$script_dir/../bin/deepseek.mjs" ]; then
    cd "$script_dir/.." >/dev/null 2>&1 && pwd
    return 0
  fi

  # Current directory
  if [ -f "$script_dir/deepseek.mjs" ]; then
    cd "$script_dir" >/dev/null 2>&1 && pwd
    return 0
  fi

  # Fallback
  echo "/opt/ai-free"
}

BASE_DIR="$(resolve_base_dir)"
ENTRY_POINT="${BASE_DIR}/bin/deepseek.mjs"

if [ ! -f "$ENTRY_POINT" ]; then
  msg "❌ Ошибка: Файл точки входа не найден: $ENTRY_POINT\nУстановите WebAIFreeAPI в /opt/ai-free или задайте переменную AI_FREE_HOME." \
      "❌ Error: Entrypoint not found: $ENTRY_POINT\nPlease install WebAIFreeAPI into /opt/ai-free or set AI_FREE_HOME variable." >&2
  exit 1
fi

# Application constants
USER_DATA_DIR="${HOME}/.deepseek-cli"
USER_LOG_DIR="${AI_FREE_LOG_DIR:-${HOME}/.ai-free/logs}"
PID_FILE="${HOME}/.ai-free/ai-free.pid"
DEFAULT_WEB_PORT="${DEEPSEEK_WINDOW_PORT:-4317}"
DEFAULT_API_PORT="${API_PORT:-4318}"
SERVICE_NAME="ai-free.service"

# ==============================================================================
# Port and Process Helpers
# ==============================================================================
is_port_listening() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    if ss -tlpn 2>/dev/null | grep -q ":${port} "; then
      return 0
    fi
  elif command -v netstat >/dev/null 2>&1; then
    if netstat -tlpn 2>/dev/null | grep -q ":${port} "; then
      return 0
    fi
  elif command -v lsof >/dev/null 2>&1; then
    if lsof -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1; then
      return 0
    fi
  fi

  if command -v curl >/dev/null 2>&1; then
    if curl -s --connect-timeout 1 "http://127.0.0.1:${port}/" >/dev/null 2>&1; then
      return 0
    fi
  fi

  return 1
}

has_systemd_user() {
  command -v systemctl >/dev/null 2>&1 && systemctl --user list-units >/dev/null 2>&1
}

ensure_user_unit_installed() {
  if ! has_systemd_user; then
    return 1
  fi

  local user_unit_dir="${HOME}/.config/systemd/user"
  local target_unit="${user_unit_dir}/${SERVICE_NAME}"
  local source_unit="${BASE_DIR}/linux/${SERVICE_NAME}"

  if [ ! -f "$target_unit" ] && [ ! -f "/usr/lib/systemd/user/${SERVICE_NAME}" ]; then
    if [ -f "$source_unit" ]; then
      mkdir -p "$user_unit_dir"
      cp -f "$source_unit" "$target_unit"
      systemctl --user daemon-reload 2>/dev/null || true
      msg "✓ Юнит ${SERVICE_NAME} установлен в ${user_unit_dir}" \
          "✓ Installed ${SERVICE_NAME} to ${user_unit_dir}"
    fi
  fi
  return 0
}

# ==============================================================================
# Command: --status
# ==============================================================================
cmd_status() {
  msg "\033[1m=== Статус WebAIFreeAPI ===\033[0m" "\033[1m=== WebAIFreeAPI Status ===\033[0m"

  local running=0
  local systemd_active=0

  # 1. Systemd check
  if has_systemd_user; then
    if systemctl --user is-active --quiet "${SERVICE_NAME}" 2>/dev/null; then
      systemd_active=1
      running=1
      msg "● Служба systemd: \033[32mАКТИВНА (active)\033[0m" \
          "● Systemd service: \033[32mACTIVE\033[0m"
    fi
  fi

  # 2. PID file check
  if [ -f "$PID_FILE" ]; then
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null || echo "")
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      running=1
      msg "● Фоновый процесс (PID: $pid): \033[32mРАБОТАЕТ\033[0m" \
          "● Background process (PID: $pid): \033[32mRUNNING\033[0m"
    fi
  fi

  # 3. Process table check
  if [ $running -eq 0 ]; then
    local pids
    pids=$(pgrep -f "deepseek\.mjs" 2>/dev/null || echo "")
    if [ -n "$pids" ]; then
      running=1
      local formatted_pids
      formatted_pids=$(echo "$pids" | tr '\n' ' ')
      msg "● Обнаружен процесс Node.js (PID: ${formatted_pids}): \033[32mРАБОТАЕТ\033[0m" \
          "● Node.js process detected (PID: ${formatted_pids}): \033[32mRUNNING\033[0m"
    fi
  fi

  if [ $running -eq 0 ]; then
    msg "○ Состояние сервиса: \033[33mОСТАНОВЛЕН (inactive)\033[0m" \
        "○ Service status: \033[33mSTOPPED (inactive)\033[0m"
  fi

  # Port checks
  echo ""
  if is_port_listening "$DEFAULT_WEB_PORT"; then
    msg "● Веб-интерфейс: \033[32mhttp://127.0.0.1:${DEFAULT_WEB_PORT}\033[0m (доступен)" \
        "● Web UI: \033[32mhttp://127.0.0.1:${DEFAULT_WEB_PORT}\033[0m (online)"
  else
    msg "○ Веб-интерфейс: порт ${DEFAULT_WEB_PORT} закрыт" \
        "○ Web UI: port ${DEFAULT_WEB_PORT} closed"
  fi

  if is_port_listening "$DEFAULT_API_PORT"; then
    msg "● OpenAI-совместимый API: \033[32mhttp://127.0.0.1:${DEFAULT_API_PORT}/v1\033[0m (доступен)" \
        "● OpenAI-compatible API: \033[32mhttp://127.0.0.1:${DEFAULT_API_PORT}/v1\033[0m (online)"
  else
    msg "○ OpenAI-совместимый API: порт ${DEFAULT_API_PORT} закрыт" \
        "○ OpenAI-compatible API: port ${DEFAULT_API_PORT} closed"
  fi

  # Recent logs
  local log_file="${USER_LOG_DIR}/ai-free.log"
  if [ -f "$log_file" ]; then
    echo ""
    msg "Последние записи журнала (${log_file}):" \
        "Recent log entries (${log_file}):"
    tail -n 6 "$log_file" 2>/dev/null || true
  elif [ $systemd_active -eq 1 ] && command -v journalctl >/dev/null 2>&1; then
    echo ""
    msg "Последние записи journalctl:" \
        "Recent journalctl entries:"
    journalctl --user -u "${SERVICE_NAME}" -n 6 --no-pager 2>/dev/null || true
  fi
}

# ==============================================================================
# Command: --stop
# ==============================================================================
cmd_stop() {
  msg "Остановка процессов WebAIFreeAPI..." "Stopping WebAIFreeAPI processes..."
  local stopped=0

  # 1. Stop systemd service
  if has_systemd_user; then
    if systemctl --user is-active --quiet "${SERVICE_NAME}" 2>/dev/null; then
      systemctl --user stop "${SERVICE_NAME}" 2>/dev/null || true
      msg "✓ Служба systemd остановлена." "✓ Systemd service stopped."
      stopped=1
    fi
  fi

  # 2. Stop PID file process
  if [ -f "$PID_FILE" ]; then
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null || echo "")
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill -15 "$pid" 2>/dev/null || true
      local waited=0
      while kill -0 "$pid" 2>/dev/null && [ $waited -lt 10 ]; do
        sleep 0.5
        waited=$((waited + 1))
      done
      if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null || true
      fi
      msg "✓ Процесс (PID: $pid) завершен." "✓ Process (PID: $pid) terminated."
      stopped=1
    fi
    rm -f "$PID_FILE" 2>/dev/null || true
  fi

  # 3. Terminate any remaining deepseek.mjs instances
  local pids
  pids=$(pgrep -f "deepseek\.mjs" 2>/dev/null || echo "")
  if [ -n "$pids" ]; then
    for p in $pids; do
      kill -15 "$p" 2>/dev/null || true
    done
    sleep 1
    pkill -9 -f "deepseek\.mjs" 2>/dev/null || true
    msg "✓ Оставшиеся процессы завершены." "✓ Remaining processes terminated."
    stopped=1
  fi

  if [ $stopped -eq 1 ]; then
    msg "✅ WebAIFreeAPI успешно остановлен." "✅ WebAIFreeAPI stopped successfully."
  else
    msg "ℹ Процессы WebAIFreeAPI не были запущены." "ℹ No running WebAIFreeAPI processes found."
  fi
}

# ==============================================================================
# Command: --service
# ==============================================================================
cmd_start_daemon() {
  if [ -f "$PID_FILE" ]; then
    local old_pid
    old_pid=$(cat "$PID_FILE" 2>/dev/null || echo "")
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
      msg "⚠ WebAIFreeAPI уже запущен с PID $old_pid." \
          "⚠ WebAIFreeAPI is already running with PID $old_pid."
      return 0
    fi
  fi

  mkdir -p "$USER_LOG_DIR"
  local log_file="${USER_LOG_DIR}/ai-free.log"

  msg "Запуск WebAIFreeAPI в фоновом режиме..." \
      "Starting WebAIFreeAPI in background mode..."

  NODE_ENV=production nohup "$NODE_BIN" "$ENTRY_POINT" --no-window >> "$log_file" 2>&1 &
  local new_pid=$!
  mkdir -p "$(dirname "$PID_FILE")"
  echo "$new_pid" > "$PID_FILE"

  sleep 1
  if kill -0 "$new_pid" 2>/dev/null; then
    msg "✅ WebAIFreeAPI запущен (PID: $new_pid)." \
        "✅ WebAIFreeAPI started (PID: $new_pid)."
    msg "   Веб-интерфейс: http://127.0.0.1:${DEFAULT_WEB_PORT}" \
        "   Web UI: http://127.0.0.1:${DEFAULT_WEB_PORT}"
    msg "   Логи: ${log_file}" \
        "   Logs: ${log_file}"
  else
    msg "❌ Не удалось запустить фоновый процесс. Проверьте журнал: $log_file" \
        "❌ Failed to start background process. Check log file: $log_file" >&2
    rm -f "$PID_FILE"
    exit 1
  fi
}

cmd_service() {
  local subcmd="${1:-start}"

  case "$subcmd" in
    stop)
      cmd_stop
      return 0
      ;;
    status)
      cmd_status
      return 0
      ;;
    restart)
      cmd_stop
      sleep 1
      cmd_service start
      return 0
      ;;
    logs)
      if has_systemd_user; then
        journalctl --user -u "${SERVICE_NAME}" -f
      else
        tail -f "${USER_LOG_DIR}/ai-free.log"
      fi
      return 0
      ;;
    start|"")
      if has_systemd_user; then
        ensure_user_unit_installed || true
        msg "Запуск службы WebAIFreeAPI через systemd..." \
            "Starting WebAIFreeAPI service via systemd..."
        systemctl --user enable "${SERVICE_NAME}" 2>/dev/null || true
        systemctl --user start "${SERVICE_NAME}"
        sleep 1
        if systemctl --user is-active --quiet "${SERVICE_NAME}" 2>/dev/null; then
          msg "✅ Служба systemd успешно активна." \
              "✅ Systemd service is active."
          msg "   Веб-интерфейс: http://127.0.0.1:${DEFAULT_WEB_PORT}" \
              "   Web UI: http://127.0.0.1:${DEFAULT_WEB_PORT}"
          msg "   Журнал: journalctl --user -u ${SERVICE_NAME} -f" \
              "   Logs: journalctl --user -u ${SERVICE_NAME} -f"
          return 0
        else
          msg "⚠ Не удалось активировать systemd юнит, переключение на фоновый режим..." \
              "⚠ Systemd activation failed, falling back to background daemon..."
        fi
      fi
      cmd_start_daemon
      ;;
    *)
      msg "Неизвестная подкоманда службы: $subcmd (допустимо: start, stop, restart, status, logs)" \
          "Unknown service subcommand: $subcmd (valid: start, stop, restart, status, logs)" >&2
      exit 1
      ;;
  esac
}

# ==============================================================================
# Command: --tray
# ==============================================================================
cmd_tray() {
  # 1. Ensure server is running in background
  if ! is_port_listening "$DEFAULT_WEB_PORT"; then
    if has_systemd_user; then
      ensure_user_unit_installed || true
      systemctl --user start "${SERVICE_NAME}" 2>/dev/null || cmd_start_daemon
    else
      cmd_start_daemon
    fi
  fi

  # 2. Desktop notification
  if command -v notify-send >/dev/null 2>&1; then
    local icon_opt=()
    if [ -f "${BASE_DIR}/linux/assets/ai-free.svg" ]; then
      icon_opt=(-i "${BASE_DIR}/linux/assets/ai-free.svg")
    fi
    notify-send "${icon_opt[@]}" \
      "WebAIFreeAPI" \
      "Фоновая служба активна: http://127.0.0.1:${DEFAULT_WEB_PORT}" 2>/dev/null || true
  fi

  # 3. If python tray helper exists, run it
  local tray_py="${BASE_DIR}/linux/bin/ai-free-tray.py"
  if [ -f "$tray_py" ] && command -v python3 >/dev/null 2>&1; then
    python3 "$tray_py" &
    return 0
  fi

  msg "WebAIFreeAPI запущен в фоновом режиме (http://127.0.0.1:${DEFAULT_WEB_PORT})" \
      "WebAIFreeAPI is running in background mode (http://127.0.0.1:${DEFAULT_WEB_PORT})"
}

# ==============================================================================
# Command: --help
# ==============================================================================
cmd_help() {
  msg "Использование: ai-free [РЕЖИМ/ОПЦИЯ] [АРГУМЕНТЫ...]" \
      "Usage: ai-free [MODE/OPTION] [ARGUMENTS...]"
  echo ""
  msg "Режимы запуска и системные команды:" \
      "Execution modes and system commands:"
  printf "  %-24s %s\n" "--window" "Запуск Web UI в окне браузера / Run Web UI in browser window"
  printf "  %-24s %s\n" "--no-window" "Запуск веб-сервера без открытия окна / Run server without opening window"
  printf "  %-24s %s\n" "--api" "Запуск OpenAI-совместимого API (порт 4318) / Run OpenAI-compatible API"
  printf "  %-24s %s\n" "--service [cmd]" "Управление systemd службой (start|stop|status|restart|logs)"
  printf "  %-24s %s\n" "--tray" "Запуск в фоне с уведомлением / Launch in background with tray/notification"
  printf "  %-24s %s\n" "--status" "Проверка статуса сервиса и портов / Check service and ports status"
  printf "  %-24s %s\n" "--stop" "Остановка всех запущенных сервисов / Stop all running processes"
  printf "  %-24s %s\n" "--help, -h" "Показать данную справку / Show this help"
  echo ""
  msg "Команды CLI и прямое использование:" \
      "CLI commands and direct usage:"
  printf "  %-24s %s\n" "ai-free" "Интерактивный диалог в терминале / Interactive terminal chat"
  printf "  %-24s %s\n" "ai-free \"запрос\"" "Быстрый ответ нейросети в терминал / Quick prompt answer"
  printf "  %-24s %s\n" "ai-free --login" "Авторизация DeepSeek через браузер / Login to DeepSeek via browser"
  printf "  %-24s %s\n" "ai-free --check" "Проверка окружения и токенов / Check environment & tokens"
  echo ""
}

# ==============================================================================
# Argument Dispatcher
# ==============================================================================
ACTION="${1:-}"

case "$ACTION" in
  --status)
    cmd_status
    exit 0
    ;;
  --stop)
    cmd_stop
    exit 0
    ;;
  --service)
    shift
    cmd_service "${1:-start}"
    exit 0
    ;;
  --tray)
    cmd_tray
    exit 0
    ;;
  --help|-h)
    cmd_help
    exit 0
    ;;
  --window|--no-window|--api)
    # Forward dedicated modes directly to node entrypoint with environment configured
    cd "$BASE_DIR"
    exec "$NODE_BIN" "$ENTRY_POINT" "$@"
    ;;
  *)
    # Default CLI mode: passes all parameters directly to deepseek.mjs
    cd "$BASE_DIR"
    exec "$NODE_BIN" "$ENTRY_POINT" "$@"
    ;;
esac
